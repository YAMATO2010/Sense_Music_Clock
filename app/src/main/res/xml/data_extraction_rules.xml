<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <include domain="database" path="app_database" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="profiles/" />

        <exclude domain="file" path="backgrounds/"
            tools:ignore="FullBackupContent" />
        <exclude domain="file" path="crash_logs"
            tools:ignore="FullBackupContent" />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="app_database" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="profiles/" />
        <include domain="file" path="backgrounds/" />

        <exclude domain="file" path="crash_logs"
            tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>
